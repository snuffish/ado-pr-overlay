{
  "manifest_version": 3,
  "name": "ADO PR Overlay",
  "version": "0.3.0",
  "description": "Shows each Azure DevOps pull request comment thread's ID as a click-to-copy badge, and collapses or expands threads.",
  "homepage_url": "https://github.com/snuffish/ado-pr-overlay",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://dev.azure.com/*", "https://*.visualstudio.com/*"],
      "js": ["content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ]
}
